# GEMINI_API_KEY: Server-side API key for WordPath AI Mentor & Writing Coach (Gemini API).
# AI Studio injects this automatically from Settings > Secrets.
# For local or Netlify deployment, set this in your environment variables (never prefix with VITE_).
GEMINI_API_KEY=

# Optional model override (defaults to gemini-4-hydrogen)
GEMINI_MODEL=gemini-4-hydrogen

# PORT: Server port (AI Studio uses 3000)
PORT=3000

# APP_URL: Hosted URL for the application (injected automatically in AI Studio)
APP_URL=
